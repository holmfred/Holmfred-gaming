# Get a key at https://www.mobygames.com/info/api/
MOBYGAMES_API_KEY=your_api_key_here

# Supabase project: https://supabase.com/dashboard
# Settings → API → Project URL + anon/publishable key
# Do NOT use the secret / service_role key in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Email(s) allowed to delete add-ons (comma-separated)
VITE_ADMIN_EMAIL=you@example.com
